{
  "$defs": {
    "ArtifactHeader": {
      "additionalProperties": false,
      "properties": {
        "bound": {
          "$ref": "#/$defs/Bound"
        },
        "protected_set_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protected Set Digest",
          "type": "string"
        },
        "schema": {
          "const": "orqlet.artifact-header/v1",
          "title": "Schema",
          "type": "string"
        },
        "specialists": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Specialist"
          },
          "title": "Specialists",
          "type": "array"
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "task": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Task",
          "type": "string"
        },
        "workflow_version": {
          "minLength": 1,
          "title": "Workflow Version",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "task",
        "status",
        "workflow_version",
        "protected_set_digest",
        "bound"
      ],
      "title": "ArtifactHeader",
      "type": "object"
    },
    "AsIsScope": {
      "additionalProperties": false,
      "properties": {
        "paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "request_ref": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Request Ref",
          "type": "string"
        }
      },
      "required": [
        "paths",
        "request_ref"
      ],
      "title": "AsIsScope",
      "type": "object"
    },
    "Bound": {
      "additionalProperties": false,
      "properties": {
        "applicable_rules_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Applicable Rules Hash",
          "type": "string"
        },
        "base_revision": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Base Revision",
          "type": "string"
        },
        "profile_version": {
          "minimum": 0,
          "title": "Profile Version",
          "type": "integer"
        },
        "standards_lock_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Standards Lock Hash",
          "type": "string"
        },
        "upstream": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Upstream"
          },
          "title": "Upstream",
          "type": "array"
        }
      },
      "required": [
        "base_revision",
        "standards_lock_hash",
        "applicable_rules_hash",
        "profile_version"
      ],
      "title": "Bound",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "how": {
          "title": "How",
          "type": "string"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "not-run"
          ],
          "title": "Result",
          "type": "string"
        },
        "what": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "what",
        "how",
        "result"
      ],
      "title": "Check",
      "type": "object"
    },
    "CheckedAgainst": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "applicable_standards": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Applicable Standards",
          "type": "array"
        },
        "confirmed_requirements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Confirmed Requirements",
          "type": "array"
        },
        "evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "phase": {
          "minLength": 1,
          "title": "Phase",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "phase"
      ],
      "title": "CheckedAgainst",
      "type": "object"
    },
    "Contradiction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^C-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "merged_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Merged From",
          "type": "array"
        },
        "note": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "sources",
        "note"
      ],
      "title": "Contradiction",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/FactEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^A-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "structure",
            "interface",
            "dependency",
            "flow",
            "test",
            "operation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "statement",
        "evidence"
      ],
      "title": "Fact",
      "type": "object"
    },
    "FactEvidence": {
      "additionalProperties": false,
      "properties": {
        "lines": {
          "pattern": "^[1-9]\\d*(-[1-9]\\d*)?$",
          "title": "Lines",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "revision": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Revision",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "lines",
        "revision",
        "sha256"
      ],
      "title": "FactEvidence",
      "type": "object"
    },
    "SelfCheck": {
      "additionalProperties": false,
      "properties": {
        "checked_against": {
          "$ref": "#/$defs/CheckedAgainst"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Checks",
          "type": "array"
        },
        "failures": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Failures",
          "type": "array"
        },
        "questions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Questions",
          "type": "array"
        },
        "schema": {
          "const": "orqlet.self-check/v1",
          "title": "Schema",
          "type": "string"
        },
        "unverified": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unverified",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "checked_against"
      ],
      "title": "SelfCheck",
      "type": "object"
    },
    "SizeBudget": {
      "additionalProperties": false,
      "properties": {
        "max_words": {
          "exclusiveMinimum": 0,
          "title": "Max Words",
          "type": "integer"
        }
      },
      "required": [
        "max_words"
      ],
      "title": "SizeBudget",
      "type": "object"
    },
    "Specialist": {
      "additionalProperties": false,
      "description": "Recorded and validated for shape, not for truth.",
      "properties": {
        "binding": {
          "minLength": 1,
          "title": "Binding",
          "type": "string"
        },
        "client": {
          "minLength": 1,
          "title": "Client",
          "type": "string"
        },
        "parallel": {
          "title": "Parallel",
          "type": "boolean"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "client",
        "binding",
        "parallel"
      ],
      "title": "Specialist",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^U-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "material": {
          "title": "Material",
          "type": "boolean"
        },
        "merged_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Merged From",
          "type": "array"
        },
        "question_ref": {
          "anyOf": [
            {
              "pattern": "^Q-\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Ref"
        },
        "what": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "id",
        "what",
        "material"
      ],
      "title": "Unknown",
      "type": "object"
    },
    "Upstream": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "title": "Upstream",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Base Revision",
      "type": "string"
    },
    "contradictions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Contradiction"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "header": {
      "$ref": "#/$defs/ArtifactHeader"
    },
    "limitation": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limitation"
    },
    "research_mode": {
      "enum": [
        "parallel-subagents",
        "sequential-subagents",
        "sequential"
      ],
      "title": "Research Mode",
      "type": "string"
    },
    "schema": {
      "const": "orqlet.as-is/v1",
      "title": "Schema",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/AsIsScope"
    },
    "self_check": {
      "$ref": "#/$defs/SelfCheck"
    },
    "size_budget": {
      "$ref": "#/$defs/SizeBudget"
    },
    "unknowns": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Unknown"
      },
      "title": "Unknowns",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "header",
    "base_revision",
    "scope",
    "research_mode",
    "size_budget",
    "self_check"
  ],
  "title": "AsIsArtifact",
  "type": "object"
}

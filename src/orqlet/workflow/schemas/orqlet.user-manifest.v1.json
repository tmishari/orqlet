{
  "$defs": {
    "UserManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "owners": {
          "items": {
            "enum": [
              "claude-code",
              "codex",
              "cursor",
              "copilot"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Owners",
          "type": "array"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "workflow_version": {
          "title": "Workflow Version",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "workflow_version",
        "owners"
      ],
      "title": "UserManifestEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "change_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,63}$",
      "title": "Change Id",
      "type": "string"
    },
    "created_at": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[0-9:.]+(Z|[+-]\\d{2}:\\d{2})?)?$",
      "title": "Created At",
      "type": "string"
    },
    "entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UserManifestEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "roots": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Roots",
      "type": "object"
    },
    "schema": {
      "const": "orqlet.user-manifest/v1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "change_id",
    "created_at"
  ],
  "title": "UserManifest",
  "type": "object"
}

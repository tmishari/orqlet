{
  "$defs": {
    "ManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ManifestEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`MANIFEST.json`: every workflow file with its hash. Its digest identifies a release.",
  "properties": {
    "controls_level": {
      "minimum": 0,
      "title": "Controls Level",
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ManifestEntry"
      },
      "title": "Files",
      "type": "array"
    },
    "schema": {
      "const": "orqlet.workflow-manifest/v1",
      "title": "Schema",
      "type": "string"
    },
    "workflow_version": {
      "title": "Workflow Version",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "workflow_version",
    "controls_level",
    "files"
  ],
  "title": "WorkflowManifest",
  "type": "object"
}

{
  "$defs": {
    "AbsenceRecord": {
      "additionalProperties": false,
      "properties": {
        "candidates_found": {
          "minimum": 0,
          "title": "Candidates Found",
          "type": "integer"
        },
        "index_state": {
          "minLength": 1,
          "title": "Index State",
          "type": "string"
        },
        "method": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "revision": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Revision",
          "type": "string"
        },
        "scopes_searched": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Scopes Searched",
          "type": "array"
        },
        "views": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Views",
          "type": "array"
        }
      },
      "required": [
        "scopes_searched",
        "views",
        "revision",
        "method",
        "index_state",
        "candidates_found"
      ],
      "title": "AbsenceRecord",
      "type": "object"
    },
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "candidates_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidates Digest",
          "type": "string"
        },
        "command": {
          "const": "orqlet knowledge impact",
          "title": "Command",
          "type": "string"
        },
        "index_state": {
          "minLength": 1,
          "title": "Index State",
          "type": "string"
        },
        "input": {
          "const": "pre-draft-tree",
          "title": "Input",
          "type": "string"
        },
        "orqlet_version": {
          "minLength": 1,
          "title": "Orqlet Version",
          "type": "string"
        },
        "views": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Views",
          "type": "array"
        }
      },
      "required": [
        "command",
        "orqlet_version",
        "candidates_digest",
        "candidate_count",
        "input",
        "views",
        "index_state"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/KnowledgeEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^CL-\\d+$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "anchor",
        "evidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "DocumentedRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "DocumentedRef",
      "type": "object"
    },
    "Entry": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "add",
            "correct",
            "supersede",
            "remove",
            "unaffected",
            "proposal"
          ],
          "title": "Action",
          "type": "string"
        },
        "candidate_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Ref"
        },
        "claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KnowledgeEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^K-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "replaces": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaces"
        },
        "scope": {
          "enum": [
            "project",
            "team",
            "company"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "id",
        "action",
        "scope"
      ],
      "title": "Entry",
      "type": "object"
    },
    "KnowledgeEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "code",
            "test",
            "design",
            "adr",
            "source",
            "developer-statement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "sha256"
      ],
      "title": "KnowledgeEvidence",
      "type": "object"
    },
    "NoImpact": {
      "additionalProperties": false,
      "properties": {
        "absence_record": {
          "$ref": "#/$defs/AbsenceRecord"
        },
        "already_documented_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DocumentedRef"
          },
          "title": "Already Documented Refs",
          "type": "array"
        },
        "category": {
          "enum": [
            "internal-refactor",
            "test-only",
            "mechanical-dependency-change",
            "already-documented",
            "behaviour-unchanged"
          ],
          "title": "Category",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "category",
        "reason",
        "absence_record"
      ],
      "title": "NoImpact",
      "type": "object"
    },
    "ReviewInput": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "code_tests",
              "knowledge",
              "design",
              "plan",
              "standards",
              "reviewer_definition",
              "evidence_inputs",
              "candidates"
            ]
          },
          "title": "Components",
          "type": "object"
        },
        "covers": {
          "items": {
            "enum": [
              "code_tests",
              "knowledge",
              "design",
              "plan",
              "standards",
              "reviewer_definition",
              "evidence_inputs",
              "candidates"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Covers",
          "type": "array"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "merge_base": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Merge Base",
          "type": "string"
        },
        "schema": {
          "const": "orqlet.review-input/v1",
          "default": "orqlet.review-input/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "covers",
        "components",
        "digest",
        "merge_base"
      ],
      "title": "ReviewInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "$ref": "#/$defs/Analysis"
    },
    "entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "title": "Entries",
      "type": "array"
    },
    "no_impact": {
      "anyOf": [
        {
          "$ref": "#/$defs/NoImpact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "enum": [
        "updated",
        "no-impact"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "phase": {
      "pattern": "^P-[1-9]\\d*$",
      "title": "Phase",
      "type": "string"
    },
    "review_input": {
      "$ref": "#/$defs/ReviewInput"
    },
    "schema": {
      "const": "orqlet.knowledge-impact/v1",
      "title": "Schema",
      "type": "string"
    },
    "task": {
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Task",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "task",
    "phase",
    "review_input",
    "outcome",
    "analysis"
  ],
  "title": "KnowledgeImpact",
  "type": "object"
}
